# ═══════════════════════════════════════════════
# MedAI — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ═══════════════════════════════════════════════

# ─── Flask ───
FLASK_SECRET_KEY=change-this-to-a-random-long-string-in-production
FLASK_ENV=development
PORT=5000
LOG_LEVEL=INFO

# ─── CORS / Frontend ───
# Comma-separated list of origins allowed to call the API in production, e.g.:
#   ALLOWED_ORIGINS=https://medai.example.com,https://app.example.com
# Leave both empty for local development (CORS falls back to permissive).
ALLOWED_ORIGINS=
FRONTEND_URL=

# ─── Medical Knowledge Base ───
# Path to the PDF used for RAG ingestion. Standardized across the whole app.
MEDICAL_PDF_PATH=data/medical_book.pdf

# ─── LLM Provider ───
# Choose: "groq" (FREE) or "openai" (paid)
LLM_PROVIDER=groq

# Groq API — Free at console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# OpenAI API — Used if LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# ─── Pinecone Vector DB ───
# Get free API key at pinecone.io
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=medai-knowledge
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ─── RAG Configuration ───
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=20
RETRIEVAL_TOP_K=4
